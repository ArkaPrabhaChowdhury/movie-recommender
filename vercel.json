{
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.py"
        },
        {
            "source": "/assets/(.*)",
            "destination": "/movie-recommender-frontend/dist/assets/$1"
        },
        {
            "source": "/details/(.*)",
            "destination": "/movie-recommender-frontend/dist/index.html"
        },
        {
            "source": "/profile",
            "destination": "/movie-recommender-frontend/dist/index.html"
        },
        {
            "source": "/my-list",
            "destination": "/movie-recommender-frontend/dist/index.html"
        },
        {
            "source": "/vite.svg",
            "destination": "/movie-recommender-frontend/dist/vite.svg"
        },
        {
            "source": "/",
            "destination": "/movie-recommender-frontend/dist/index.html"
        }
    ],
    "crons": [
        {
            "path": "/api/cron/weekly-recommendations",
            "schedule": "0 9 * * 1"
        }
    ]
}