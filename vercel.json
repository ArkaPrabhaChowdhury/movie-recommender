{
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?path=/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/((?!api|assets|vite.svg|icon.svg).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/weekly-recommendations",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/watching-notifications",
      "schedule": "0 9 * * *"
    }
  ]
}
